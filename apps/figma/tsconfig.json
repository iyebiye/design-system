{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "node_modules/@figma/plugin-typings/index.d.ts"
  ],
  "exclude": ["dist"]
}